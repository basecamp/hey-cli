#!/usr/bin/env python3
"""Offline contracts for the thin runner, not live HEY verification."""
import contextlib
import io
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

MODULE = runpy.run_path(str(Path(__file__).with_name("smoke")))
EXECUTE = MODULE["execute"]


class RunnerTests(unittest.TestCase):
    def test_missing_skipped_failed_or_nonzero_is_not_pass(self):
        audit = MODULE["audit"]
        passed = {"Action": "pass", "Test": "TestChosen"}
        for events, code in [([], 0), ([passed], 7), ([passed, {"Action": "skip", "Test": "TestChosen/subcase"}], 0),
                             ([passed, {"Action": "fail"}], 0)]:
            self.assertFalse(audit(events, ["TestChosen"], code)["ok"])
        self.assertTrue(audit([passed], ["TestChosen"], 0)["ok"])

    def test_refuses_nonlocal_and_auth_or_regex_before_launch(self):
        for origin, names in [("https://app.hey.com", ["TestChosen"]),
                              ("http://app.hey.localhost:3003", ["TestAuthToken"]),
                              ("http://app.hey.localhost:3003", ["TestChosen|TestOther"])]:
            with patch.dict(os.environ, {"HEY_SMOKE_BASE_URL": origin}), self.assertRaises(ValueError):
                EXECUTE(Path("not-a-binary"), names, "1m", "")

    def test_missing_ps_refuses_launch_and_unknown_liveness_does_not_pass(self):
        with patch.object(shutil, "which", return_value=None), \
             patch.dict(os.environ, {"HEY_SMOKE_BASE_URL": "http://app.hey.localhost:3003"}), \
             self.assertRaisesRegex(ValueError, "ps"):
            EXECUTE(Path("not-a-binary"), ["TestChosen"], "1m", "")
        with patch.object(subprocess, "run", side_effect=FileNotFoundError("ps unavailable")):
            self.assertTrue(MODULE["group_running"](123456789))

    @unittest.skipUnless(os.name == "posix" and shutil.which("ps"), "requires POSIX process groups and ps")
    def test_stubborn_owned_process_group_is_stopped(self):
        child = "import signal,time; signal.signal(signal.SIGTERM,signal.SIG_IGN); print('ready',flush=True); time.sleep(60)"
        leader = "import subprocess,sys; p=subprocess.Popen([sys.executable,'-c'," + repr(child) + "],stdout=subprocess.PIPE,text=True); print(p.stdout.readline().strip(),flush=True)"
        process = subprocess.Popen([sys.executable, "-c", leader], stdout=subprocess.PIPE, text=True, start_new_session=True)
        try:
            self.assertEqual(process.stdout.readline().strip(), "ready")
            process.wait(timeout=5)  # The leader is gone, but its stubborn child still owns the group.
            self.assertTrue(MODULE["group_running"](process.pid))
            self.assertTrue(MODULE["stop_group"](process.pid))
            self.assertFalse(MODULE["group_running"](process.pid))
        finally:
            try:
                os.killpg(process.pid, 9)
            except ProcessLookupError:
                pass  # The stop assertion already removed the owned group.
            process.wait()
            process.stdout.close()

    @unittest.skipUnless(os.name == "posix" and shutil.which("ps"), "requires POSIX process groups and ps")
    def test_real_process_status_pin_private_evidence_and_retained_state(self):
        for code, name, leftover, stopped in [(0, "TestChosen", False, True), (7, "TestChosen", False, True),
                                             (0, "TestOther", False, True), (0, "TestChosen", True, True),
                                             (0, "TestChosen", False, False)]:
            with self.subTest(code=code, name=name, leftover=leftover), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                (root / "tests/smoke").mkdir(parents=True)
                binary = root / "hey"
                binary.write_text("synthetic binary")
                fake = root / "go"
                fake.write_text("#!/usr/bin/env python3\nimport json,os\nfrom pathlib import Path\n"
                                + ("Path(os.environ['TMPDIR'],'hey-smoke-interrupted').mkdir()\n" if leftover else "")
                                + "print(json.dumps({'Action':'pass','Test':" + repr(name) + "}))\n"
                                + "raise SystemExit(" + str(code) + ")\n")
                fake.chmod(0o700)
                real_stop = MODULE["stop_group"]
                with patch.dict(EXECUTE.__globals__, ROOT=root, stop_group=real_stop if stopped else lambda _: False), \
                     patch.dict(os.environ, {"PATH": str(root) + os.pathsep + os.environ["PATH"],
                                             "HEY_SMOKE_BASE_URL": "http://app.hey.localhost:3003", "HEY_TOKEN": "SYNTHETIC"}), \
                     contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                    status, run = EXECUTE(binary, ["TestChosen"], "1m", "")
                try:
                    result = json.loads((run / "result.json").read_text())
                    self.assertEqual(result["ok"], code == 0 and name == "TestChosen" and not leftover and stopped)
                    self.assertEqual(result["process_group_stopped"], stopped)
                    self.assertEqual(status, 7 if code == 7 else 0 if result["ok"] else 1)
                    self.assertTrue((run / "events.jsonl").exists())
                    self.assertTrue((run / "hey").exists())
                    self.assertEqual(run.stat().st_mode & 0o777, 0o700)
                    self.assertEqual((run / "tmp").exists(), leftover or not stopped)
                    self.assertNotIn("SYNTHETIC", (run / "command.json").read_text())
                finally:
                    shutil.rmtree(run)


if __name__ == "__main__":
    unittest.main()
